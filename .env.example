# Application
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info
SERVICE_NAME=kapea-api

# PostgreSQL
DATABASE_URL=postgresql://kapea:kapea@localhost:5432/kapea

# Redis (BullMQ queue backend — scan-jobs / scan.requested)
REDIS_URL=redis://localhost:6379

# Quarantine object storage: minio | s3 | gcs | azure
STORAGE_PROVIDER=minio
STORAGE_BUCKET=quarantine

# MinIO / AWS S3 (also used when STORAGE_PROVIDER=minio|s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=quarantine
S3_FORCE_PATH_STYLE=true

# Google Cloud Storage (STORAGE_PROVIDER=gcs)
GCS_PROJECT_ID=
GCS_KEY_FILENAME=
GCS_CREDENTIALS_JSON=

# Azure Blob Storage (STORAGE_PROVIDER=azure)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# Scan limits
MAX_UPLOAD_BYTES=104857600
SCAN_TIMEOUT_SECONDS=60

# Service ports (NestJS apps)
RESULT_CONSUMER_PORT=3001
RETENTION_WORKER_PORT=3003

# Cloud API by default. For >20MB downloads, run local Bot API and set:
# Host path of the same volume (hybrid Nest on host)

# Retention worker
RETENTION_INTERVAL_MS=300000

# YARA rules directory (local dev default; /rules in containers)
YARA_RULES_PATH=./infrastructure/yara/rules

# Rust scan worker (BullMQ consumer on Redis)
WORK_DIR=/tmp/kapea
WORKER_ID=
SCAN_WORKER_CONCURRENCY=10

# Auth (dev only — replace in production)
REQUIRE_API_KEY=false
API_KEY=dev-api-key
ADMIN_API_KEY=dev-admin-key
JWT_SECRET=change-me-in-production

# Upload rate limit (Redis); set UPLOAD_RATE_LIMIT=0 to disable
UPLOAD_RATE_LIMIT=30
UPLOAD_RATE_WINDOW_SECONDS=60

# Scan extraction limits (included in scan.requested BullMQ job data)
SCAN_MAX_EXTRACTED_BYTES=524288000
SCAN_MAX_FILES=1000
SCAN_MAX_DEPTH=5

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Docker / migrations
RUN_MIGRATIONS=true
