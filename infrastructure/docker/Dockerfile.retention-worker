# syntax=docker/dockerfile:1
# Build from repo root: docker build -f infrastructure/docker/Dockerfile.retention-worker .

FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.18.0 --activate
WORKDIR /app

FROM base AS deps
ENV npm_config_fetch_timeout=600000 \
  npm_config_fetch_retries=5 \
  PNPM_NETWORK_CONCURRENCY=4
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/common/package.json packages/common/
COPY packages/database/package.json packages/database/
COPY packages/storage/package.json packages/storage/
COPY packages/observability/package.json packages/observability/
COPY apps/retention-worker/package.json apps/retention-worker/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm config set store-dir /pnpm/store \
  && pnpm install --frozen-lockfile

FROM deps AS build
COPY packages packages
COPY apps/retention-worker apps/retention-worker
ENV DATABASE_URL="postgresql://kapea:kapea@postgres:5432/kapea"
RUN pnpm --filter @kapea/database prisma:generate \
  && pnpm --filter @kapea/contracts build \
  && pnpm --filter @kapea/common build \
  && pnpm --filter @kapea/database build \
  && pnpm --filter @kapea/storage build \
  && pnpm --filter @kapea/observability build \
  && pnpm --filter @kapea/retention-worker build
RUN pnpm --filter @kapea/retention-worker deploy --prod --legacy /out

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache curl \
  && addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nestjs
COPY --from=build /out /app
RUN chown -R nestjs:nodejs /app
USER nestjs
EXPOSE 3003
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:${RETENTION_WORKER_PORT:-3003}/health/live || exit 1
CMD ["node", "dist/main.js"]
